{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "__RICE_HOME__/.config/fastfetch/cat-headphones-transparent.png",
    "width": 32,
    "height": 16,
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;176;158;155",
      "title": "38;2;212;208;200",
      "separator": "38;2;98;101;106"
    },
    "key": {
      "width": 12
    },
    "percent": {
      "type": 1
    }
  },
  "modules": [
    "break",
    "title",
    {
      "type": "custom",
      "format": "\u001b[38;2;98;101;106m──────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "system"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "wm",
      "key": "desktop"
    },
    {
      "type": "terminal",
      "key": "terminal"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    "break",
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "gpu",
      "key": "gpu"
    },
    {
      "type": "memory",
      "key": "memory"
    },
    {
      "type": "disk",
      "key": "disk",
      "folders": "/",
      "format": "{1} / {2}"
    },
    "break",
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break"
  ]
}
