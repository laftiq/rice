configuration {
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}


* {
    background: #242424;
    foreground: #d0d0d0;
    selected: #454545;

    background-color: transparent;
    text-color: @foreground;
    font: "DejaVu Sans Mono 10";
}

window {
    width: 420px;
    location: northeast;
    anchor: northeast;
    x-offset: -8px;
    y-offset: 38px;

    padding: 6px;
    border: 0px;
    border-color: #454545;
    border-radius: 0px;
    background-color: @background;
}

mainbox {
    spacing: 0px;
    children: [listview];
}

inputbar {
    enabled: false;
}

listview {
    lines: 6;
    columns: 1;
    spacing: 2px;
    scrollbar: false;
    fixed-height: false;
}

element {
    padding: 8px;
    border-radius: 0px;
}

element selected {
    background-color: @selected;
}

element-text {
    text-color: @foreground;
    horizontal-align: 0.0;
}

element-icon {
    enabled: false;
}

/* Explicit cursor for popup backgrounds and mouse grabs. */
* { cursor: default; }
window { cursor: default; }
mainbox { cursor: default; }
listview { cursor: default; }
element { cursor: pointer; }
element-text { cursor: pointer; }
entry { cursor: text; }

/* Match the storage menu: mark the focused row with a left stripe. */
element normal.normal, element normal.active, element normal.urgent,
element selected.normal, element selected.active, element selected.urgent {
    background-color: transparent;
    border: 0px 0px 0px 2px;
    border-color: transparent;
    border-radius: 0px;
}
element selected.normal, element selected.active, element selected.urgent {
    border-color: #B8B8B8;
}
element-text, element-icon {
    background-color: transparent;
}
element-text selected.normal, element-text selected.active, element-text selected.urgent {
    background-color: transparent;
    text-color: #D0D0D0;
}
