configuration {
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}
* {
    background-color: transparent;
    text-color: #D0D0D0;
    font: "DejaVu Sans Mono 10";
    border: 0px;
    margin: 0px;
    padding: 0px;
}
window {
    width: 260px;
    location: northeast;
    anchor: northeast;
    x-offset: -8px;
    y-offset: 38px;
    padding: 12px;
    background-color: #242424;
}
mainbox { children: [message, listview]; spacing: 10px; }
message { expand: false; }
textbox { expand: false; markup: true; vertical-align: 0.0; }
listview {
    lines: 1;
    columns: 3;
    flow: horizontal;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
}
element { padding: 6px 2px; }
element selected { background-color: #343434; }
element-text { horizontal-align: 0.5; }
element-icon { enabled: false; }
inputbar { enabled: false; }

/* Explicit cursor for popup backgrounds and mouse grabs. */
* { cursor: default; }
window { cursor: default; }
mainbox { cursor: default; }
listview { cursor: default; }
element { cursor: pointer; }
element-text { cursor: pointer; }
entry { cursor: text; }

/* Match the storage menu: mark the focused row with a left stripe. */
element normal.normal, element normal.active, element normal.urgent,
element selected.normal, element selected.active, element selected.urgent {
    background-color: transparent;
    border: 0px 0px 0px 2px;
    border-color: transparent;
    border-radius: 0px;
}
element selected.normal, element selected.active, element selected.urgent {
    border-color: #B8B8B8;
}
element-text, element-icon {
    background-color: transparent;
}
element-text selected.normal, element-text selected.active, element-text selected.urgent {
    background-color: transparent;
    text-color: #D0D0D0;
}
