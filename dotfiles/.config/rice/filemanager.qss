QWidget {
    background-color: #242424;
    color: #D0D0D0;
    font-family: "DejaVu Sans";
    font-size: 13px;
}
QMainWindow { background: #242424; }
QAbstractItemView {
    background-color: #202020;
    alternate-background-color: #242424;
    selection-background-color: #454545;
    selection-color: #FFFFFF;
    border: none;
    outline: none;
}
QTreeView { padding: 5px; }
QTreeView::item { padding: 4px 3px; min-height: 22px; }
QListView { padding: 8px; }
QListView::item { padding: 5px; border-radius: 3px; }
QAbstractItemView::item:hover { background: #303030; }
QAbstractItemView::item:selected { background: #454545; color: #FFFFFF; }
QToolBar {
    background: #282828;
    border: none;
    spacing: 4px;
    padding: 5px;
}
QToolButton { border: none; padding: 5px; border-radius: 3px; background: transparent; }
QToolButton:hover, QToolButton:checked { background: #454545; }
QLineEdit {
    background: #202020;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    padding: 5px 7px;
    selection-background-color: #555555;
}
QLineEdit:focus { border-color: #777777; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: #282828; padding: 8px 18px; border: none; color: #858585; }
QTabBar::tab:selected { background: #3C3C3C; color: #D0D0D0; }
QTabBar::tab:hover { background: #343434; }
QMenuBar, QStatusBar { background: #242424; border: none; }
QMenuBar::item:selected { background: #454545; }
QMenu { background: #282828; border: 1px solid #3C3C3C; padding: 4px; }
QMenu::item { padding: 6px 24px; }
QMenu::item:selected { background: #454545; }
QHeaderView::section { background: #282828; border: none; padding: 6px; color: #858585; }
QScrollBar:vertical { background: #242424; width: 7px; border: none; }
QScrollBar:horizontal { background: #242424; height: 7px; border: none; }
QScrollBar::handle { background: #555555; border-radius: 3px; min-height: 24px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QSplitter::handle { background: #303030; width: 1px; height: 1px; }
QPushButton { background: #343434; border: none; border-radius: 3px; padding: 6px 14px; }
QPushButton:hover { background: #454545; }
QToolTip { background: #343434; color: #D0D0D0; border: none; padding: 5px; }
