/* Match the charcoal Laptos Rice palette. */
QWidget {
    background-color: #242424;
    color: #d0d0d0;
    font-family: "DejaVu Sans";
    font-size: 13px;
}
QLabel { background: transparent; }
QLineEdit, QComboBox {
    background: #202020;
    border: 1px solid #3c3c3c;
    border-radius: 0px;
    padding: 5px 7px;
    selection-background-color: #555555;
    selection-color: #ffffff;
    min-height: 20px;
}
QLineEdit:focus, QComboBox:focus { border-color: #777777; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #282828;
    color: #d0d0d0;
    selection-background-color: #454545;
    selection-color: #ffffff;
    border: 1px solid #454545;
    outline: none;
}
QPushButton {
    background: #343434;
    border: 1px solid #454545;
    border-radius: 0px;
    padding: 6px 14px;
    min-height: 20px;
}
QPushButton:hover { background: #454545; }
QPushButton:pressed { background: #505050; }
QPushButton:default, QPushButton:focus { border-color: #777777; }
QPushButton:disabled { background: #282828; color: #777777; }
QToolButton { background: transparent; border: none; padding: 5px; }
QToolButton:hover { background: #454545; }
QToolTip { background: #343434; color: #d0d0d0; border: 1px solid #454545; padding: 5px; }

/* Flat controls and a visible, neutral keyboard focus. */
QDialog { background: #242424; }
QPushButton { icon-size: 0px; }
QComboBox::drop-down {
    background: #343434;
    border-left: 1px solid #454545;
}
QComboBox::down-arrow {
    image: url("__RICE_HOME__/.config/rice/policykit-arrow.svg");
    width: 10px;
    height: 6px;
}
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 14px; height: 14px;
    background: #202020; border: 1px solid #555555;
}
QCheckBox::indicator:checked { background: #858585; }
